{
  "name": "dk-viewphone-desktop",
  "version": "1.0.1",
  "description": "Desktop device-farm viewer for ĐK ViewPhone",
  "main": "main.cjs",
  "author": "DangKhoa512",
  "license": "GPL-2.0-only",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "sprintf-js": "1.1.4"
  },
  "build": {
    "appId": "com.dk.viewphone.desktop",
    "productName": "ĐK ViewPhone Desktop",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "scanner.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../layout/usr/share/trollvnc/webclients",
        "to": "webclients"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "DKViewPhone_Desktop_${version}_${arch}.${ext}"
    }
  }
}
