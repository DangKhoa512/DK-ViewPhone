#!/usr/bin/env bash
set -eu
case "${1:-}" in
  remove|upgrade|deconfigure) ;;
  *) exit 0 ;;
esac
# Use RootHide's bootstrap launchctl and its virtual jbroot paths.
SERV_AGENT="/Library/LaunchDaemons/com.82flex.trollvnc.plist"
if [ -f "$SERV_AGENT" ]; then
  launchctl unload "$SERV_AGENT" >/dev/null 2>&1 ||
    launchctl remove com.82flex.trollvnc >/dev/null 2>&1 || true
else
  launchctl remove com.82flex.trollvnc >/dev/null 2>&1 || true
fi
