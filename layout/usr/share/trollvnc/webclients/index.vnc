<!doctype html>
<html lang="vi"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="referrer" content="no-referrer">
<title>ĐK ViewPhone · Multi-Device Viewer</title><style id="dk-theme">:root{font-family:Segoe UI,system-ui,sans-serif;color:#203452;background:#f3f7fc;color-scheme:light;--blue:#2563eb;--blue-soft:#e8f0ff;--line:#dce5f1;--green:#16a979;--red:#dc4c64;--muted:#71819a}*{box-sizing:border-box}body{margin:0;min-height:100dvh;background:#f3f7fc}button,input,select{font:inherit}button{cursor:pointer;border:1px solid var(--line);border-radius:10px;background:#fff;color:#304767;padding:9px 14px;font-weight:650}button:hover{background:#eef4ff}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #86b4ff;outline-offset:2px}button:disabled{opacity:.45;cursor:default}.primary{background:var(--blue);color:#fff;border-color:var(--blue)}.primary:hover{background:#1d4ed8}.danger{color:#b4233b}.app-header{display:flex;align-items:center;gap:20px;background:#fff;padding:14px 28px;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20}.brand{display:flex;align-items:center;gap:10px;font-weight:750;white-space:nowrap}.logo{display:grid;place-items:center;width:36px;height:36px;border-radius:11px;color:#fff;background:var(--blue)}.device{min-width:0;flex:1;display:flex;flex-direction:column;gap:4px}.device strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px}.device span{color:var(--muted);font-size:12px}.status{display:flex;align-items:center;gap:7px;white-space:nowrap;font-size:13px;color:#697c97}.dot,.card-dot{width:8px;height:8px;background:#94a3b8;border-radius:50%;flex:none}.online .dot,.card-status.online .card-dot{background:var(--green)}.online,.card-status.online{color:#158166}.view-switch{display:flex;gap:8px;padding:10px 28px;background:#fff;border-bottom:1px solid var(--line)}.view-tab{border-radius:999px;padding:8px 18px}.view-tab.active{background:var(--blue);border-color:var(--blue);color:#fff}.connection-bar{display:flex;align-items:center;gap:10px;padding:9px 28px;background:#f8fbff;border-bottom:1px solid var(--line);font-size:13px}.connection-label{color:#526b8b;font-weight:650;margin-right:2px}.mode{position:relative}.mode input{position:absolute;opacity:0;pointer-events:none}.mode span{display:block;padding:7px 15px;border:1px solid var(--line);border-radius:999px;background:#fff;color:#526b8b;font-weight:650;cursor:pointer}.mode input:checked+span{background:var(--blue);border-color:var(--blue);color:#fff}.mode input:focus-visible+span{outline:3px solid #86b4ff;outline-offset:2px}.usb-port{display:flex;align-items:center;gap:8px;color:#526b8b}.usb-port input,.number-input{width:86px;padding:7px 9px;border:1px solid var(--line);border-radius:8px;background:#fff;color:#203452}.notice{padding:9px 28px;font-size:12px;color:#785518;background:#fff8e7;border-bottom:1px solid #f3e3b5}.notice.secure{color:#22765d;background:#effaf5;border-color:#d7efe2}.workspace{height:calc(100dvh - 248px);min-height:360px;position:relative;overflow:hidden;margin:20px 28px;border:1px solid var(--line);border-radius:18px;background:#eaf0f8;background-image:radial-gradient(#ccd9ea .8px,transparent .8px);background-size:16px 16px;box-shadow:0 5px 30px #2c497608}.screen{width:100%;height:100%;overflow:auto}.empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;pointer-events:none}.empty>div{max-width:360px;padding:25px}.empty .phone,.card-placeholder .phone{margin:0 auto 18px;border:3px solid #9bb4d6;border-radius:15px;width:55px;height:88px}.empty h1{font-size:22px;font-weight:650}.empty p{font-size:14px;color:var(--muted);line-height:1.7}.toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:15px;padding:0 28px 20px}.toolbar label{font-size:13px;display:flex;align-items:center;gap:7px}.toolbar input{accent-color:var(--blue)}.metrics{margin-left:auto;font-size:12px;color:var(--muted)}.message{margin:0 28px 10px;min-height:20px;color:#526b8b;font-size:13px}.multi-panel{padding-bottom:28px}.multi-toolbar{display:flex;align-items:end;gap:13px;flex-wrap:wrap;padding:16px 28px;background:#f8fbff;border-bottom:1px solid var(--line)}.multi-toolbar label{display:flex;flex-direction:column;gap:5px;color:#526b8b;font-size:12px;font-weight:650}.multi-toolbar input,.multi-toolbar select{border:1px solid var(--line);border-radius:9px;background:#fff;padding:8px;color:#203452}.multi-actions{display:flex;gap:8px;flex-wrap:wrap;margin-right:auto}.search-field input{width:210px}.device-grid{--columns:3;display:grid;grid-template-columns:repeat(var(--columns),minmax(240px,1fr));gap:16px;padding:8px 28px 20px}.device-grid.columns-2{--columns:2}.device-grid.columns-3{--columns:3}.device-grid.columns-4{--columns:4}.device-card{min-width:0;background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:0 5px 20px #2c497610;display:flex;flex-direction:column}.device-card.hidden-card{display:none}.card-header{display:flex;align-items:center;gap:9px;padding:12px}.card-select{accent-color:var(--blue)}.card-title{min-width:0;flex:1}.card-title strong,.card-title span{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.card-title strong{font-size:14px}.card-title span{font-size:11px;color:var(--muted);margin-top:3px}.card-status{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--muted)}.icon-button{padding:5px 8px;border-radius:8px;font-size:12px}.card-preview{position:relative;display:block;border:0;border-radius:0;padding:0;width:100%;height:300px;background:#eaf0f8;overflow:hidden}.card-screen{width:100%;height:100%;pointer-events:none}.card-placeholder{position:absolute;inset:0;display:grid;place-items:center;color:var(--muted);font-size:12px;text-align:center;padding:20px}.card-placeholder .phone{width:36px;height:60px;border-width:2px;margin-bottom:10px}.card-actions{display:flex;gap:8px;padding:10px 12px}.card-actions button{padding:7px 10px;font-size:12px}.card-actions .open-device{margin-left:auto}.multi-empty{text-align:center;color:var(--muted);padding:60px 20px}dialog{border:1px solid var(--line);border-radius:18px;padding:28px;max-width:440px;width:calc(100% - 30px);box-shadow:0 24px 80px #162d5a30}dialog::backdrop{background:#14284555;backdrop-filter:blur(3px)}dialog h2{margin:0 0 12px;font-size:21px}dialog p{font-size:13px;line-height:1.7;color:#667d9b}dialog form>label:not(.check-row){display:flex;flex-direction:column;gap:6px;margin:12px 0;color:#526b8b;font-size:13px;font-weight:650}dialog input,dialog select{width:100%;border:1px solid var(--line);padding:10px;border-radius:9px;background:#fff;color:#203452}.check-row{display:flex;align-items:center;gap:8px;margin:10px 0;font-size:13px}.check-row input{width:auto}.form-help{margin:12px 0}.form-error{min-height:18px;color:#b4233b;font-size:12px}.actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px}[hidden]{display:none!important}#workspace:fullscreen{margin:0;border:0;border-radius:0;background:#101c2e}.card-preview:focus-visible{outline:3px solid #86b4ff;outline-offset:-3px}@media(max-width:1100px){.device-grid.columns-4{--columns:3}}@media(max-width:850px){.device-grid{--columns:2!important}.app-header{padding:12px 16px}.view-switch,.connection-bar,.notice{padding-left:16px;padding-right:16px}.multi-toolbar{padding:14px 16px}.device-grid{padding-left:16px;padding-right:16px}.card-preview{height:270px}}@media(max-width:600px){.brand .wordmark{display:none}.device-grid{--columns:1!important}.connection-bar{flex-wrap:wrap}.connection-label{width:100%}.workspace{margin:12px;height:calc(100dvh - 270px)}.toolbar{padding:0 12px 12px;gap:10px}.message{margin:0 15px 8px}.metrics{width:100%;margin-left:0}.card-preview{height:360px}.search-field,.search-field input{width:100%}}
</style><script defer src="viewer.bundle.js"></script>
</head><body data-rfb-port="$PORT">
<header class="app-header"><div class="brand"><span class="logo" aria-hidden="true">ĐK</span><span class="wordmark">ĐK ViewPhone</span></div>
<div class="device"><strong id="deviceName">iPhone · USB / LAN Viewer</strong><span id="address"></span></div>
<div id="status" class="status" role="status"><span class="dot"></span><span id="state">Chưa kết nối</span></div><button id="headerDisconnect" disabled>Ngắt kết nối</button></header>
<nav class="view-switch" aria-label="Chế độ hiển thị">
<button id="singleTab" class="view-tab active" aria-pressed="true">Single View</button>
<button id="multiTab" class="view-tab" aria-pressed="false">Multi View</button>
</nav>
<section id="singlePanel">
<div class="connection-bar"><span class="connection-label">Chế độ kết nối</span>
<label class="mode"><input id="modeLan" name="connectionMode" type="radio" value="lan" checked><span>LAN</span></label>
<label class="mode"><input id="modeUsb" name="connectionMode" type="radio" value="usb"><span>USB</span></label>
<label id="usbPortField" class="usb-port" hidden>Cổng VNC trên PC <input id="usbPort" type="number" min="1" max="65535" value="5901" inputmode="numeric"></label></div>
<div class="notice" id="transport"></div>
<main class="workspace" id="workspace"><div id="screen" class="screen" aria-label="Màn hình iPhone"></div>
<div id="empty" class="empty"><div><div class="phone"></div><h1>iPhone, ngay trên máy tính.</h1><p>Nhấn Kết nối để xem và điều khiển. Chế độ không mật khẩu chỉ phù hợp với LAN tin cậy.</p></div></div></main>
<div id="message" class="message" role="status"></div>
<footer class="toolbar"><button class="primary" id="connect">Kết nối</button><button id="disconnect" disabled>Ngắt kết nối</button><button id="fullscreen">Toàn màn hình</button>
<label><input id="viewOnly" type="checkbox">Chỉ xem</label><label><input id="autoScale" type="checkbox" checked>Tự co giãn</label><label><input id="reconnect" type="checkbox" checked>Tự kết nối lại</label>
<span class="metrics" title="noVNC hiện tại không xuất số đo FPS và độ trễ chính xác; không hiển thị số ước đoán.">FPS — · Latency —</span></footer>
</section>
<section id="multiPanel" class="multi-panel" hidden>
<div class="multi-toolbar">
<div class="multi-actions"><button class="primary" id="addDevice">Thêm thiết bị</button><button id="connectSelected">Kết nối đã chọn</button><button id="disconnectSelected">Ngắt kết nối đã chọn</button></div>
<label class="search-field">Tìm kiếm <input id="deviceSearch" type="search" placeholder="Tên hoặc IP"></label>
<label>Bộ lọc <select id="deviceFilter"><option value="all">Tất cả</option><option value="online">Online</option><option value="offline">Offline</option></select></label>
<label>Số cột <select id="gridColumns"><option value="2">2</option><option value="3" selected>3</option><option value="4">4</option></select></label>
<label>Live tối đa <input id="liveLimit" class="number-input" type="number" min="1" max="12" value="6"></label>
</div>
<div class="notice">Multi View ưu tiên chỉ xem và chỉ tạo stream khi card hiện trong vùng nhìn. Trang này có thể kết nối tới các iPhone LAN khác; nếu iPhone đang phục vụ giao diện mất mạng, trang không thể tải lại.</div>
<div id="multiMessage" class="message" role="status">Thêm iPhone bằng IPv4 LAN. Mật khẩu chỉ giữ trong bộ nhớ của tab hiện tại.</div>
<main id="deviceGrid" class="device-grid columns-3" aria-live="polite"></main>
<div id="noDevices" class="multi-empty" hidden>Không có thiết bị phù hợp.</div>
</section>
<dialog id="deviceEditor"><form id="deviceForm"><h2 id="deviceEditorTitle">Thêm thiết bị</h2>
<input id="deviceId" type="hidden">
<label>Tên thiết bị<input id="deviceLabel" required maxlength="60" placeholder="iPhone 01"></label>
<label>Chế độ<select id="deviceMode"><option value="lan">LAN</option><option value="usb">USB</option></select></label>
<label>IPv4 iPhone<input id="deviceHost" required inputmode="decimal" placeholder="192.168.1.158"></label>
<label>Cổng VNC / cổng forward trên PC<input id="deviceVncPort" required type="number" min="1" max="65535" value="5901"></label>
<label>WebSocket URL tùy chọn<input id="deviceWebsocket" type="url" placeholder="ws://192.168.1.158:5901/websockify"></label>
<label class="check-row"><input id="deviceViewOnly" type="checkbox" checked> Chỉ xem trong Multi View</label>
<label class="check-row"><input id="deviceReconnect" type="checkbox" checked> Tự kết nối lại</label>
<p class="form-help">Không nhập mật khẩu tại đây. Với USB, mỗi iPhone cần một cổng forward riêng trên PC. URL tùy chọn không được chứa tài khoản hoặc mật khẩu.</p>
<div id="deviceFormError" class="form-error" role="alert"></div>
<div class="actions"><button type="button" id="cancelDevice">Hủy</button><button type="submit" class="primary">Lưu</button></div></form></dialog>
<dialog id="login"><form id="loginForm"><h2 id="loginTitle">Kết nối iPhone</h2><p>Nhập mật khẩu VNC trong Settings → ĐK ViewPhone. Mật khẩu chỉ nằm trong bộ nhớ của tab và không được lưu.</p>
<label for="password">Mật khẩu VNC</label><input id="password" type="password" required autocomplete="off" spellcheck="false" maxlength="8">
<div class="actions"><button type="button" id="cancel">Hủy</button><button type="submit" class="primary">Kết nối</button></div></form></dialog>
</body></html>
