<!doctype html>
<html lang="vi"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="referrer" content="no-referrer">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ws: wss:; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'">
<title>ĐK ViewPhone · Device Farm</title><style id="dk-theme">:root{font-family:Inter,"Segoe UI",system-ui,sans-serif;color:#14233b;background:#eef3f9;color-scheme:light;--blue:#1769e8;--blue-dark:#0d55c7;--blue-soft:#eaf2ff;--ink:#14233b;--muted:#708099;--line:#dce5f0;--surface:#fff;--green:#14a673;--amber:#dd8a13;--red:#cf4059;--shadow:0 10px 30px rgba(33,58,95,.09)}*{box-sizing:border-box}body{margin:0;min-height:100dvh;background:#eef3f9}button,input,select{font:inherit}button{cursor:pointer;border:1px solid var(--line);border-radius:10px;background:#fff;color:#29415f;padding:9px 13px;font-weight:650;transition:background .15s,border-color .15s,transform .15s}button:hover{background:#f4f7fb;border-color:#c9d6e6}button:active{transform:translateY(1px)}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #86b4ff;outline-offset:2px}button:disabled{opacity:.46;cursor:default;transform:none}.primary{background:var(--blue);border-color:var(--blue);color:#fff}.primary:hover{background:var(--blue-dark);border-color:var(--blue-dark)}.danger-button{color:#bd334c;border-color:#f0cbd2;background:#fff7f8}.danger-button:hover{background:#ffecef}.icon-button{width:34px;height:34px;padding:0;display:grid;place-items:center;font-size:18px}.eyebrow{display:block;color:#8090a7;font-size:10px;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}[hidden]{display:none!important}

.topbar{height:70px;display:flex;align-items:center;gap:22px;padding:10px 24px;position:sticky;top:0;z-index:40;background:rgba(255,255,255,.96);border-bottom:1px solid var(--line);backdrop-filter:blur(12px)}.brand-block{min-width:250px;display:flex;align-items:center;gap:11px}.brand-block>div{display:flex;flex-direction:column}.brand-block strong{font-size:17px;letter-spacing:-.02em}.brand-block div span{font-size:11px;color:var(--muted);margin-top:2px}.logo{width:40px;height:40px;border-radius:12px;background:linear-gradient(145deg,#2380ff,#1357d2);box-shadow:0 7px 18px rgba(23,105,232,.25);color:#fff;display:grid;place-items:center;font-weight:850}.top-mode{margin-right:auto;padding-left:17px;border-left:1px solid var(--line)}.top-mode strong{display:block;font-size:13px;margin-top:3px}.top-stat{min-width:92px;display:flex;align-items:center;gap:9px}.top-stat strong,.top-stat span{display:block}.top-stat strong{font-size:15px}.top-stat div span{font-size:10px;color:var(--muted);margin-top:2px}.stat-icon{width:9px;height:9px;border-radius:50%;background:#a5b2c4;box-shadow:0 0 0 5px #eff2f6}.online-stat.active .stat-icon{background:var(--green);box-shadow:0 0 0 5px #e0f6ee}

.controlbar{display:flex;align-items:flex-end;gap:10px;padding:12px 24px;background:#f8fafc;border-bottom:1px solid var(--line);position:sticky;top:70px;z-index:35}.control-actions{display:flex;gap:8px;margin-right:auto}.search-field input{width:230px}.search-field input,.compact-field select,.compact-field input{height:38px;border:1px solid var(--line);border-radius:9px;background:#fff;color:var(--ink);padding:0 11px}.compact-field{display:flex;flex-direction:column;gap:3px;font-size:10px;color:var(--muted);font-weight:700}.compact-field select{min-width:92px}.compact-field .number-input{width:74px}.trust-notice{padding:7px 24px;color:#785518;background:#fff8e7;border-bottom:1px solid #f0dfae;font-size:11px}.trust-notice.secure{color:#187257;background:#effaf5;border-color:#d4ecdf}.dashboard-message{min-height:31px;padding:8px 24px;color:#5f718a;background:#fff;border-bottom:1px solid var(--line);font-size:11px}

.dashboard-shell{display:grid;grid-template-columns:minmax(0,1fr);gap:16px;padding:18px 24px 28px;align-items:start}.dashboard-shell.focus-open{grid-template-columns:minmax(0,1fr) minmax(380px,34vw)}.fleet-area{min-width:0}.section-heading{height:43px;display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}.section-heading h1{font-size:20px;line-height:1.1;margin:2px 0 0;letter-spacing:-.025em}.count-pill{padding:5px 10px;border-radius:999px;background:#dfe9f6;color:#52677f;font-size:11px;font-weight:750}

.device-grid{--columns:3;display:grid;grid-template-columns:repeat(var(--columns),minmax(220px,1fr));gap:13px}.device-grid.columns-2{--columns:2}.device-grid.columns-3{--columns:3}.device-grid.columns-4{--columns:4}.device-grid.columns-5{--columns:5}.device-card{min-width:0;display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--line);border-radius:15px;background:var(--surface);box-shadow:0 5px 18px rgba(35,57,89,.06);transition:border-color .16s,box-shadow .16s,transform .16s}.device-card:hover{transform:translateY(-1px);box-shadow:var(--shadow)}.device-card.selected{border-color:#72a8f7;box-shadow:0 0 0 2px rgba(23,105,232,.12),var(--shadow)}.device-card.controlling{border-color:var(--blue);box-shadow:0 0 0 2px rgba(23,105,232,.18),var(--shadow)}.device-card.hidden-card{display:none}.card-top{display:flex;align-items:center;gap:8px;padding:10px 10px 9px}.card-select{accent-color:var(--blue);width:15px;height:15px}.card-title{min-width:0;flex:1}.card-title strong,.card-title span{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.card-title strong{font-size:13px}.card-title span{font-size:10px;color:var(--muted);margin-top:3px}.card-menu{display:flex;gap:4px}.card-menu button{padding:4px 6px;border:0;font-size:11px;color:#687991;background:transparent}.card-menu .delete-device:hover{color:var(--red);background:#fff0f2}.card-preview{position:relative;height:260px;margin:0 9px;border:1px solid #dbe4ef;border-radius:11px;padding:0;overflow:hidden;background:#dfe7f1;background-image:radial-gradient(#c6d2e1 .7px,transparent .7px);background-size:13px 13px}.card-preview:hover{background:#dfe7f1}.card-screen{width:100%;height:100%;pointer-events:none}.card-screen canvas{pointer-events:none!important}.card-placeholder{position:absolute;inset:0;display:grid;place-items:center;text-align:center;color:var(--muted);font-size:10px;padding:18px}.card-placeholder strong,.card-placeholder span{display:block}.card-placeholder strong{color:#52667f;font-size:11px;margin-bottom:4px}.card-placeholder .empty-phone{width:29px;height:49px;margin-bottom:9px;border-radius:8px}.card-state-layer{position:absolute;top:8px;left:8px;display:flex;align-items:center;gap:5px;padding:4px 7px;background:rgba(17,30,49,.72);color:#fff;border-radius:999px;font-size:9px;font-weight:750;backdrop-filter:blur(5px)}.card-state-layer i,.session-status i{width:6px;height:6px;border-radius:50%;background:#a9b4c2}.card-state-layer.online i,.session-status.online i{background:#27d695;box-shadow:0 0 0 3px rgba(39,214,149,.18)}.card-state-layer.connecting i,.session-status.connecting i,.card-state-layer.retry i{background:#f5aa36}.focus-badge{position:absolute;right:8px;top:8px;padding:4px 7px;border-radius:999px;background:var(--blue);color:#fff;font-size:9px;font-weight:800}.card-bottom{display:flex;align-items:center;gap:6px;padding:9px}.card-bottom button{padding:6px 8px;font-size:10px}.card-bottom .open-device{margin-left:auto;background:var(--blue-soft);border-color:#cfe0fc;color:#165cbd}.transport-chip{font-size:9px;font-weight:800;color:#58708f;background:#eef3f8;border-radius:5px;padding:3px 5px}.empty-fleet{min-height:420px;display:grid;place-items:center;align-content:center;text-align:center;border:1px dashed #c8d5e5;border-radius:16px;background:rgba(255,255,255,.55);padding:30px}.empty-fleet h2{font-size:17px;margin:14px 0 3px}.empty-fleet p{color:var(--muted);font-size:12px;margin:0 0 16px}.empty-phone{width:42px;height:70px;border:2px solid #91a8c5;border-radius:12px;position:relative}.empty-phone:after{content:"";position:absolute;width:14px;height:2px;border-radius:2px;background:#91a8c5;top:5px;left:50%;transform:translateX(-50%)}

.focus-panel{position:sticky;top:145px;max-height:calc(100dvh - 163px);display:flex;flex-direction:column;overflow:hidden;border:1px solid #cad8e9;border-radius:17px;background:#fff;box-shadow:0 18px 45px rgba(23,43,72,.14)}.focus-header{display:flex;align-items:center;gap:9px;padding:13px 14px;border-bottom:1px solid var(--line)}.focus-title{min-width:0;flex:1}.focus-title strong,.focus-title>span:last-child{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.focus-title strong{font-size:15px;margin-top:2px}.focus-title>span:last-child{font-size:10px;color:var(--muted);margin-top:3px}.session-status{display:flex;align-items:center;gap:5px;font-size:10px;color:var(--muted);white-space:nowrap}.session-status.online{color:#128159}.session-status.connecting{color:#9c650e}.focus-switcher{display:flex;align-items:end;gap:7px;padding:9px 12px;background:#f7f9fc;border-bottom:1px solid var(--line)}.focus-switcher label{display:flex;flex:1;flex-direction:column;gap:3px;color:var(--muted);font-size:9px;font-weight:700}.focus-switcher select{width:100%;height:34px;border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink);padding:0 9px}.focus-switcher button{width:34px;height:34px;padding:0}.focus-workspace{position:relative;min-height:360px;height:calc(100dvh - 348px);overflow:hidden;background:#111c2c;background-image:radial-gradient(#26384f .7px,transparent .7px);background-size:14px 14px}.focus-screen{width:100%;height:100%;overflow:auto}.focus-placeholder{position:absolute;inset:0;display:grid;place-items:center;align-content:center;text-align:center;color:#a7b6c8;padding:30px;pointer-events:none}.focus-placeholder .empty-phone{border-color:#60748d;margin-bottom:13px}.focus-placeholder .empty-phone:after{background:#60748d}.focus-placeholder strong{font-size:13px;color:#d8e1eb;margin-bottom:4px}.focus-placeholder span{font-size:10px}.focus-toolbar{display:flex;align-items:center;gap:7px;flex-wrap:wrap;padding:10px 12px;border-top:1px solid var(--line)}.focus-toolbar button{padding:7px 9px;font-size:10px}.focus-toolbar label{display:flex;align-items:center;gap:4px;font-size:10px;color:#52677f}.focus-toolbar input{accent-color:var(--blue)}.focus-footer{display:flex;align-items:center;gap:12px;padding:0 12px 11px;color:var(--muted);font-size:9px}.focus-footer>span:first-child{min-width:0;flex:1}.metrics{white-space:nowrap}.focus-workspace:fullscreen{background:#101a29}.focus-workspace:fullscreen .focus-screen{height:100dvh}

dialog{border:1px solid var(--line);border-radius:17px;padding:24px;max-width:480px;width:calc(100% - 28px);box-shadow:0 28px 90px rgba(17,35,62,.3)}dialog::backdrop{background:rgba(15,28,48,.48);backdrop-filter:blur(4px)}dialog h2{margin:2px 0 0;font-size:20px}dialog form>label:not(.check-row),.form-grid label{display:flex;flex-direction:column;gap:5px;margin:12px 0;color:#52677f;font-size:11px;font-weight:700}dialog input,dialog select{width:100%;border:1px solid var(--line);border-radius:9px;background:#fff;color:var(--ink);padding:9px}.dialog-heading{display:flex;align-items:start;justify-content:space-between}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.check-row{display:flex;align-items:center;gap:7px;font-size:11px}.check-row input{width:auto}.form-help,dialog p{font-size:11px;line-height:1.6;color:var(--muted)}.form-error{min-height:16px;color:var(--red);font-size:11px}.dialog-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}

@media(max-width:1450px){.device-grid.columns-5{--columns:4}.dashboard-shell.focus-open .device-grid.columns-4,.dashboard-shell.focus-open .device-grid.columns-5{--columns:3}.card-preview{height:240px}}@media(max-width:1180px){.topbar{gap:14px}.brand-block{min-width:210px}.dashboard-shell.focus-open{display:block}.focus-panel{position:fixed;z-index:60;top:82px;right:18px;bottom:18px;width:min(480px,calc(100vw - 36px));max-height:none}.focus-workspace{height:auto;flex:1;min-height:300px}.dashboard-shell.focus-open:after{content:"";position:fixed;inset:0;z-index:50;background:rgba(16,31,53,.24);pointer-events:none}.focus-panel{z-index:61}.device-grid.columns-5{--columns:4}}@media(max-width:980px){.controlbar{position:static;flex-wrap:wrap;align-items:center}.control-actions{width:100%;margin:0}.search-field{flex:1}.search-field input{width:100%}.focus-panel{top:18px}.top-mode{display:none}.device-grid.columns-4,.device-grid.columns-5{--columns:3}.card-preview{height:270px}}@media(max-width:760px){.topbar{height:auto;padding:10px 14px;flex-wrap:wrap}.brand-block{min-width:0;margin-right:auto}.top-stat{min-width:auto}.top-stat div span{display:none}.controlbar{padding:10px 14px}.control-actions{overflow-x:auto;padding-bottom:3px}.control-actions button{white-space:nowrap}.trust-notice,.dashboard-message{padding-left:14px;padding-right:14px}.dashboard-shell{padding:14px}.device-grid{--columns:2!important}.card-preview{height:310px}}@media(max-width:520px){.brand-block div span,.online-stat{display:none}.topbar .danger-button{padding:8px}.compact-field{flex:1}.compact-field select,.compact-field input{width:100%!important}.device-grid{--columns:1!important}.card-preview{height:390px}.focus-panel{top:8px;right:8px;bottom:8px;width:calc(100vw - 16px)}.form-grid{grid-template-columns:1fr}}
</style><script defer src="viewer.bundle.js"></script>
</head><body data-rfb-port="$PORT">
<header class="topbar">
  <div class="brand-block"><span class="logo" aria-hidden="true">ĐK</span><div><strong>ĐK ViewPhone</strong><span>Device Farm Dashboard</span></div></div>
  <div class="top-mode"><span class="eyebrow">Kết nối</span><strong id="modeSummary">LAN</strong></div>
  <div class="top-stat online-stat"><span class="stat-icon"></span><div><strong id="onlineCount">0</strong><span>thiết bị online</span></div></div>
  <div class="top-stat"><div><strong id="liveCount">0 / 6</strong><span>phiên live</span></div></div>
  <button id="disconnectAll" class="danger-button" disabled>Ngắt tất cả</button>
</header>

<section class="controlbar" aria-label="Công cụ dashboard">
  <div class="control-actions">
    <button class="primary" id="addDevice">+ Thêm thiết bị</button>
    <button class="scan-button" id="scanLan" hidden>Quét LAN</button>
    <button id="connectSelected">Kết nối đã chọn</button>
    <button id="disconnectSelected">Ngắt đã chọn</button>
    <button id="loadDemo" title="Tạo các card offline để kiểm tra bố cục">Thêm dữ liệu mẫu</button>
  </div>
  <label class="search-field"><span class="sr-only">Tìm thiết bị</span><input id="deviceSearch" type="search" placeholder="Tìm tên hoặc địa chỉ IP…"></label>
  <label class="compact-field">Trạng thái<select id="deviceFilter"><option value="all">Tất cả</option><option value="online">Online</option><option value="offline">Offline</option></select></label>
  <label class="compact-field">Số cột<select id="gridColumns"><option value="2">2</option><option value="3" selected>3</option><option value="4">4</option><option value="5">5</option></select></label>
  <label class="compact-field">Live tối đa<input id="liveLimit" class="number-input" type="number" min="1" max="12" value="6"></label>
</section>

<div class="trust-notice" id="transportNotice">HTTP/WS không mã hóa. Chỉ sử dụng trong mạng LAN tin cậy và không mở cổng ra Internet.</div>
<div id="dashboardMessage" class="dashboard-message" role="status">Chọn một card để đánh dấu; bấm đúp để mở bảng điều khiển lớn.</div>

<main id="dashboard" class="dashboard-shell">
  <section class="fleet-area" aria-label="Danh sách thiết bị">
    <div class="section-heading"><div><span class="eyebrow">Thiết bị</span><h1>Phone farm</h1></div><span id="visibleCount" class="count-pill">0 máy</span></div>
    <div id="deviceGrid" class="device-grid columns-3" aria-live="polite"></div>
    <div id="noDevices" class="empty-fleet" hidden>
      <div class="empty-phone" aria-hidden="true"></div><h2>Chưa có thiết bị</h2>
      <p>Thêm iPhone bằng IPv4 LAN hoặc cổng USB forward riêng.</p><button class="primary" id="emptyAddDevice">Thêm thiết bị đầu tiên</button>
    </div>
  </section>

  <aside id="focusPanel" class="focus-panel" aria-label="Bảng điều khiển thiết bị" hidden>
    <div class="focus-header">
      <div class="focus-title"><span class="eyebrow">Đang điều khiển</span><strong id="focusName">iPhone</strong><span id="focusAddress"></span></div>
      <div id="focusStatus" class="session-status"><i></i><span>Chưa kết nối</span></div>
      <button id="closeFocus" class="icon-button" title="Đóng bảng điều khiển" aria-label="Đóng bảng điều khiển">×</button>
    </div>
    <div class="focus-switcher"><label>Chuyển nhanh<select id="focusDevice"></select></label><button id="previousDevice" title="Máy trước">←</button><button id="nextDevice" title="Máy tiếp theo">→</button></div>
    <div id="focusWorkspace" class="focus-workspace">
      <div id="focusScreen" class="focus-screen"></div>
      <div id="focusPlaceholder" class="focus-placeholder"><div class="empty-phone"></div><strong>Đang chuẩn bị Live View</strong><span>Phiên điều khiển được ưu tiên hơn các preview.</span></div>
    </div>
    <div class="focus-toolbar">
      <button class="primary" id="focusConnect">Kết nối</button><button id="focusDisconnect" disabled>Ngắt</button><button id="focusFullscreen">Toàn màn hình</button>
      <label><input id="focusViewOnly" type="checkbox"> Chỉ xem</label><label><input id="focusAutoScale" type="checkbox" checked> Tự co giãn</label>
    </div>
    <div class="focus-footer"><span id="focusMessage">Tap, swipe và bàn phím được gửi qua noVNC.</span><span class="metrics" title="noVNC không cung cấp số đo chính xác trong bản tích hợp này">FPS — · Latency —</span></div>
  </aside>
</main>

<dialog id="deviceEditor"><form id="deviceForm">
  <div class="dialog-heading"><div><span class="eyebrow">Cấu hình</span><h2 id="deviceEditorTitle">Thêm thiết bị</h2></div><button type="button" id="cancelDeviceTop" class="icon-button" aria-label="Đóng">×</button></div>
  <input id="deviceId" type="hidden">
  <label>Tên thiết bị<input id="deviceLabel" required maxlength="60" placeholder="iPhone 01"></label>
  <div class="form-grid"><label>Chế độ<select id="deviceMode"><option value="lan">LAN</option><option value="usb">USB</option></select></label><label>Cổng VNC / forward<input id="deviceVncPort" required type="number" min="1" max="65535" value="5901"></label></div>
  <label>IPv4 iPhone<input id="deviceHost" required inputmode="decimal" placeholder="192.168.1.158"></label>
  <label>WebSocket URL tùy chọn<input id="deviceWebsocket" type="url" placeholder="ws://192.168.1.158:5901/websockify"></label>
  <label class="check-row"><input id="deviceReconnect" type="checkbox" checked> Tự kết nối lại khi mất mạng</label>
  <p class="form-help">Preview luôn ở chế độ chỉ xem. Mỗi iPhone USB cần một cổng forward riêng. URL không được chứa tài khoản hoặc mật khẩu.</p>
  <div id="deviceFormError" class="form-error" role="alert"></div>
  <div class="dialog-actions"><button type="button" id="cancelDevice">Hủy</button><button type="submit" class="primary">Lưu thiết bị</button></div>
</form></dialog>

<dialog id="login"><form id="loginForm"><h2 id="loginTitle">Kết nối iPhone</h2><p>Nhập mật khẩu VNC trong Cài đặt → ĐK ViewPhone. Mật khẩu chỉ giữ trong bộ nhớ của tab và không được lưu.</p>
<label>Mật khẩu VNC<input id="password" type="password" required autocomplete="off" spellcheck="false" maxlength="8"></label>
<div class="dialog-actions"><button type="button" id="cancelLogin">Hủy</button><button type="submit" class="primary">Kết nối</button></div></form></dialog>
</body></html>
